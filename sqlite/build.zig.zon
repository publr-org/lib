.{
    .name = .publr_sqlite,
    .version = "0.1.0",
    .fingerprint = 0x8d3e37450b716bd6,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Build-time only: supplies the `docs` step. Ships nothing into the
        // library itself, so consumers of publr_sqlite never see it.
        .publr_tools = .{ .path = "../tools" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "tests",
        "vendor",
    },
}
